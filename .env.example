DATABASE_URL="postgresql://postgres@localhost:5544/absence_ops"
AUTH_SECRET="generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TRUST_HOST="true"

# Encrypts the identity documents and payment details in EmployeePII —
# national ID, passport, social insurance number, account number, IBAN, SWIFT.
# 32 bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Unset, the app still runs and those columns are stored in the clear — which is
# fine locally and is not fine in production. GET /api/health reports whether the
# key is loaded and what share of stored values are actually encrypted.
#
# Losing this key means losing the ability to read every encrypted value. Keep it
# in the deployment's secret store, not in this file, and back it up somewhere
# that is not the same place as the database.
PII_ENCRYPTION_KEY=""

# Escalation and notification email. Unset, mail is logged and skipped rather
# than failing the request that triggered it.
RESEND_API_KEY=""
EMAIL_FROM="Quorum <noreply@example.com>"

# Bearer secret for GET /api/cron/daily. Unset, the scheduled sweep refuses
# every caller — accruals, stale-session logouts and SLA escalations stop.
CRON_SECRET=""
